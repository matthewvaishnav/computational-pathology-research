# Historical HistoCore streaming configuration template.
# Research/development reference only; not a production deployment profile.
#
# Copy to an untracked local file and provide secrets through your environment
# or secret manager. No usable credentials are stored here.

HISTOCORE_ENV=development
HISTOCORE_LOG_LEVEL=INFO
HISTOCORE_DEBUG=false

CUDA_VISIBLE_DEVICES=0
HISTOCORE_MAX_MEMORY_GB=8
HISTOCORE_BATCH_SIZE=32
HISTOCORE_MAX_PATCHES_PER_SLIDE=10000

HISTOCORE_WORKERS=4
HISTOCORE_TIMEOUT=300
HISTOCORE_KEEP_ALIVE=2
HISTOCORE_MAX_REQUESTS=1000

REDIS_URL=redis://redis:6379
HISTOCORE_CACHE_TTL=3600
HISTOCORE_CACHE_MAX_SIZE=1000

PROMETHEUS_PORT=8002
HISTOCORE_METRICS_ENABLED=true
HISTOCORE_HEALTH_CHECK_INTERVAL=30

# Required at runtime; do not commit the value.
HISTOCORE_SECRET_KEY=
HISTOCORE_CORS_ORIGINS=http://localhost:3000
HISTOCORE_RATE_LIMIT=100/minute

# Historical integration flags. Enabling these does not establish validated
# PACS/FHIR/EMR interoperability.
HISTOCORE_PACS_ENABLED=false
HISTOCORE_FHIR_ENABLED=false
HISTOCORE_EMR_ENABLED=false

HISTOCORE_DATA_PATH=/app/data
HISTOCORE_LOG_PATH=/app/logs
HISTOCORE_CACHE_PATH=/app/cache
HISTOCORE_MODEL_PATH=/app/checkpoints
