#!/usr/bin/env python3
"""
HistoCore Command Line Interface

Production-ready CLI for computational pathology training and inference.
"""

import argparse
import sys
from pathlib import Path

def train_command(args):
    """Train a model on specified dataset."""
    import histocore
    
    print(f"🚀 Training {args.model} on {args.dataset}")
    print(f"📊 Epochs: {args.epochs}, Batch size: {args.batch_size}")
    
    results = histocore.quick_train(
        dataset=args.dataset,
        model=args.model,
        epochs=args.epochs,
        batch_size=args.batch_size,
        output_dir=args.output
    )
    
    print(f"✅ Training complete! Results saved to {args.output}")
    print(f"📈 Best accuracy: {results['best_accuracy']:.3f}")
    print(f"📈 Best AUC: {results['best_auc']:.3f}")

def benchmark_command(args):
    """Run benchmark against foundation models."""
    import histocore
    
    print(f"🔬 Running benchmark: {args.model_name}")
    print(f"📁 Output directory: {args.output}")
    
    results = histocore.benchmark(
        model_name=args.model_name,
        output_dir=args.output
    )
    
    print("✅ Benchmark complete!")
    print(f"📊 Results saved to {args.output}/benchmark_results.json")

def evaluate_command(args):
    """Evaluate a trained model."""
    from src.training import evaluate
    
    print(f"🔍 Evaluating model: {args.checkpoint}")
    
    results = evaluate(
        checkpoint_path=args.checkpoint,
        dataset=args.dataset,
        output_dir=args.output
    )
    
    print("✅ Evaluation complete!")
    print(f"📈 Test accuracy: {results['accuracy']:.3f}")
    print(f"📈 Test AUC: {results['auc']:.3f}")

def install_command(args):
    """Install dependencies and setup."""
    import subprocess
    
    print("📦 Installing HistoCore dependencies...")
    
    # Install core dependencies
    subprocess.run([sys.executable, "-m", "pip", "install", "-r", "requirements-core.txt"])
    
    if args.dev:
        print("🛠️  Installing development dependencies...")
        subprocess.run([sys.executable, "-m", "pip", "install", "-r", "requirements-dev.txt"])
    
    if args.optional:
        print("🎯 Installing optional dependencies...")
        subprocess.run([sys.executable, "-m", "pip", "install", "-r", "requirements-optional.txt"])
    
    print("✅ Installation complete!")
    print("🚀 Try: histocore train --dataset pcam --model nnmil")

def main():
    parser = argparse.ArgumentParser(
        description="HistoCore: Production-grade computational pathology framework",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  histocore train --dataset pcam --model nnmil --epochs 20
  histocore benchmark --model-name histocore --output results/
  histocore evaluate --checkpoint model.pth --dataset pcam
  histocore install --dev
        """
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Available commands')
    
    # Train command
    train_parser = subparsers.add_parser('train', help='Train a model')
    train_parser.add_argument('--dataset', default='pcam', choices=['pcam', 'camelyon'],
                             help='Dataset to train on (default: pcam)')
    train_parser.add_argument('--model', default='nnmil', choices=['nnmil', 'attention', 'clam'],
                             help='Model architecture (default: nnmil)')
    train_parser.add_argument('--epochs', type=int, default=10,
                             help='Number of epochs (default: 10)')
    train_parser.add_argument('--batch-size', type=int, default=32,
                             help='Batch size (default: 32)')
    train_parser.add_argument('--output', default='results/',
                             help='Output directory (default: results/)')
    train_parser.set_defaults(func=train_command)
    
    # Benchmark command
    benchmark_parser = subparsers.add_parser('benchmark', help='Run benchmark comparison')
    benchmark_parser.add_argument('--model-name', default='histocore',
                                 help='Model name for results (default: histocore)')
    benchmark_parser.add_argument('--output', default='results/',
                                 help='Output directory (default: results/)')
    benchmark_parser.set_defaults(func=benchmark_command)
    
    # Evaluate command
    eval_parser = subparsers.add_parser('evaluate', help='Evaluate trained model')
    eval_parser.add_argument('--checkpoint', required=True,
                            help='Path to model checkpoint')
    eval_parser.add_argument('--dataset', default='pcam', choices=['pcam', 'camelyon'],
                            help='Dataset to evaluate on (default: pcam)')
    eval_parser.add_argument('--output', default='results/',
                            help='Output directory (default: results/)')
    eval_parser.set_defaults(func=evaluate_command)
    
    # Install command
    install_parser = subparsers.add_parser('install', help='Install dependencies')
    install_parser.add_argument('--dev', action='store_true',
                               help='Install development dependencies')
    install_parser.add_argument('--optional', action='store_true',
                               help='Install optional dependencies')
    install_parser.set_defaults(func=install_command)
    
    args = parser.parse_args()
    
    if args.command is None:
        parser.print_help()
        return
    
    try:
        args.func(args)
    except KeyboardInterrupt:
        print("\n❌ Interrupted by user")
        sys.exit(1)
    except Exception as e:
        print(f"❌ Error: {e}")
        sys.exit(1)

if __name__ == '__main__':
    main()