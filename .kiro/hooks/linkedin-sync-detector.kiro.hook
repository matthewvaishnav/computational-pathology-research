{
  "enabled": true,
  "name": "LinkedIn Profile Sync",
  "description": "Detects changes to resume files and generates LinkedIn update instructions",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "Matthew_Vaishnav_Resume*.md",
      "README.md",
      "CHANGELOG.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Resume or project files changed. Compare with previous version, identify what changed (new skills, projects, achievements), and generate: 1) Exact LinkedIn profile section updates (copy-paste ready), 2) Optional LinkedIn post announcing the update, 3) Save to LINKEDIN_UPDATES.md for review"
  }
}