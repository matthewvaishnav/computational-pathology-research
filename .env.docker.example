# Local Docker development configuration
# Copy to .env, replace every CHANGE_ME value, and keep .env untracked.
#
# This file is a template for a local research stack. It is not a deployment
# configuration and contains no usable credentials.

POSTGRES_DB=medical_ai
POSTGRES_USER=medai
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://medai:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/medical_ai

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=CHANGE_ME_RANDOM_JWT_SECRET
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

MODEL_PATH=/app/checkpoints/pcam_real/best_model.pth

GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
